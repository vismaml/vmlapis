{
  "swagger": "2.0",
  "info": {
    "title": "AutoSuggest",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Jester"
    },
    {
      "name": "DataService"
    }
  ],
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/{type}/{name}:append": {
      "post": {
        "operationId": "DataService_AppendData",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DataServiceAppendDataBody"
            }
          }
        ],
        "tags": [
          "DataService"
        ]
      }
    },
    "/v1/{type}/{name}:info": {
      "get": {
        "operationId": "DataService_GetInfo",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetInfoResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DataService"
        ]
      }
    },
    "/v1/{type}/{name}:suggest": {
      "post": {
        "operationId": "Jester_Suggest",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SuggestionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/JesterSuggestBody"
            }
          }
        ],
        "tags": [
          "Jester"
        ]
      }
    },
    "/v1/{type}/{name}:update": {
      "put": {
        "operationId": "DataService_UpdateDataset",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DataServiceUpdateDatasetBody"
            }
          }
        ],
        "tags": [
          "DataService"
        ]
      }
    },
    "/v1/{type}:create": {
      "post": {
        "operationId": "DataService_CreateDataset",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DataServiceCreateDatasetBody"
            }
          }
        ],
        "tags": [
          "DataService"
        ]
      }
    },
    "/v1/{type}:delete": {
      "post": {
        "operationId": "DataService_DeleteData",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DataServiceDeleteDataBody"
            }
          }
        ],
        "tags": [
          "DataService"
        ]
      }
    }
  },
  "definitions": {
    "CalculateMetricsResponseMetricRow": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "correct": {
          "type": "integer",
          "format": "int32"
        },
        "incorrect": {
          "type": "integer",
          "format": "int32"
        },
        "confidenceLevel": {
          "$ref": "#/definitions/asgttypeConfidence"
        }
      }
    },
    "DataServiceAppendDataBody": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/typeSample"
          }
        }
      }
    },
    "DataServiceCreateDatasetBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/typeSample"
          }
        },
        "retentionPolicy": {
          "$ref": "#/definitions/typeRetentionPolicy"
        }
      }
    },
    "DataServiceDeleteDataBody": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "DataServiceUpdateDatasetBody": {
      "type": "object",
      "properties": {
        "retentionPolicy": {
          "$ref": "#/definitions/typeRetentionPolicy"
        }
      }
    },
    "JesterSuggestBody": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/typeData"
          }
        },
        "options": {
          "$ref": "#/definitions/v1SuggestionOptions"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ModelInputType": {
      "type": "string",
      "enum": [
        "FEATURE_TENSORS",
        "EXAMPLE_TENSOR"
      ],
      "default": "FEATURE_TENSORS",
      "description": "How the model takes its input. The service uses it to run the model."
    },
    "PredictionTarget": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the target."
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/PredictionTargetCandidate"
          },
          "description": "The suggested values, highest confidence first."
        },
        "unknownTargetClass": {
          "type": "boolean",
          "description": "Whether an example's value for this target is one the model wasn't trained on. The\nsuggest endpoints don't fill it in."
        }
      },
      "description": "Suggestions for one target."
    },
    "PredictionTargetCandidate": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "The suggested value."
        },
        "confidence": {
          "$ref": "#/definitions/asgttypeConfidence"
        }
      },
      "description": "A suggested value for a target."
    },
    "TargetMetricsMetric": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "number",
          "format": "float",
          "description": "Precision of the answers at this threshold: the share of them that were correct."
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "The confidence threshold these results apply to."
        },
        "answerRate": {
          "type": "number",
          "format": "float",
          "description": "Share of the evaluation examples that got an answer at this threshold."
        },
        "truePositive": {
          "type": "integer",
          "format": "int32",
          "description": "Number of true positives."
        },
        "trueNegative": {
          "type": "integer",
          "format": "int32",
          "description": "Number of true negatives."
        },
        "falsePositive": {
          "type": "integer",
          "format": "int32",
          "description": "Number of false positives."
        },
        "falseNegative": {
          "type": "integer",
          "format": "int32",
          "description": "Number of false negatives."
        },
        "mcc": {
          "type": "number",
          "format": "float",
          "description": "Matthews correlation coefficient."
        },
        "accuracy": {
          "type": "number",
          "format": "float",
          "description": "Accuracy."
        },
        "balancedAccuracy": {
          "type": "number",
          "format": "float",
          "description": "Balanced accuracy."
        },
        "precisionBoundEpsilon": {
          "type": "number",
          "format": "float",
          "description": "Epsilon of the precision bound."
        }
      },
      "description": "Evaluation results at one confidence threshold."
    },
    "asgttypeConfidence": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/definitions/asgttypeConfidenceLevel"
        },
        "value": {
          "type": "number",
          "format": "float",
          "description": "The confidence score. Higher means more likely, but use level to decide whether to trust\na suggestion."
        }
      },
      "description": "Confidence of a suggested value."
    },
    "asgttypeConfidenceLevel": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "VERY_LOW",
        "LOW",
        "MID",
        "HIGH",
        "VERY_HIGH",
        "ULTRA_HIGH"
      ],
      "default": "UNKNOWN",
      "description": "Confidence level of a suggested value. Levels are set for each target from the model's\nevaluation, so they give more stable results across model upgrades than the score. Use them\nto decide whether to trust a suggestion.\n\n - UNKNOWN: No level.\n - ULTRA_HIGH: Only returned with the ULTRA tier, for a VERY_HIGH answer that a second check confirms."
    },
    "asgttypeTier": {
      "type": "string",
      "enum": [
        "STANDARD",
        "ULTRA"
      ],
      "default": "STANDARD",
      "description": "Service tier for suggestions. The v2 suggest endpoints use it, and the v1 API always runs as\nSTANDARD.\n\n - STANDARD: The default.\n - ULTRA: Also has a second model check each VERY_HIGH answer, and returns the answer as ULTRA_HIGH\nwhen the check agrees."
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "typeConfidenceThresholds": {
      "type": "object",
      "properties": {
        "confidenceThresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/asgttypeConfidence"
          },
          "description": "The confidence value at which each level starts."
        }
      },
      "description": "Confidence thresholds of one target."
    },
    "typeData": {
      "type": "object",
      "properties": {
        "transaction": {
          "title": "Transaction-level information; at this time used only with bank transactions",
          "allOf": [
            {
              "$ref": "#/definitions/typeTransaction"
            }
          ]
        },
        "invoice": {
          "title": "Invoice-level information for e-invoices and scanned invoices and receipts",
          "allOf": [
            {
              "$ref": "#/definitions/typeInvoice"
            }
          ]
        },
        "invoiceLine": {
          "title": "Line-level information for e-invoices; use one sample per invoice line",
          "allOf": [
            {
              "$ref": "#/definitions/typeInvoiceLine"
            }
          ]
        }
      }
    },
    "typeDataset": {
      "type": "object",
      "properties": {
        "consumer": {
          "type": "string",
          "description": "Name of the project the dataset belongs to."
        },
        "name": {
          "type": "string",
          "description": "Name of the dataset."
        },
        "type": {
          "type": "string",
          "description": "Type of data in the dataset: bank, scanned-invoice or electronic-invoice-line. With the v2\nAPI, the first example you add sets it, and it's empty until then."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags the dataset was created with."
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of the dataset's targets, as given when a dataset is created with the v1 API. It's\nempty for datasets created with the v2 API."
        },
        "retentionPolicy": {
          "$ref": "#/definitions/typeRetentionPolicy"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the dataset was created, or created again after it was deleted."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "[NOT IMPLEMENTED] Not kept up to date, so it's normally 0001-01-01T00:00:00Z."
        },
        "size": {
          "type": "string",
          "format": "int64",
          "description": "[NOT IMPLEMENTED] Always empty. It's meant to be the number of examples within the\nretention window."
        },
        "truncatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the dataset was last truncated. It's 0001-01-01T00:00:00Z if it never was."
        }
      },
      "description": "A dataset of examples that Autosuggest trains models on."
    },
    "typeInvoice": {
      "type": "object",
      "properties": {
        "issueDate": {
          "type": "string",
          "format": "date-time"
        },
        "supplier": {
          "description": "supplier of the invoice. Used in electronic-invoice-line requests.",
          "allOf": [
            {
              "$ref": "#/definitions/typeSupplier"
            }
          ]
        },
        "customerRef": {
          "type": "string",
          "description": "reference to the customer. Used in electronic-invoice-line requests."
        },
        "text": {
          "type": "string",
          "description": "invoice text from the SmartScan product. Used in scanned-invoice requests."
        },
        "currency": {
          "type": "string",
          "description": "name of the currency as a string. Used in electronic-invoice-line requests."
        },
        "total": {
          "type": "number",
          "format": "float",
          "description": "total of the invoice. Used in electronic-invoice-line requests."
        }
      }
    },
    "typeInvoiceLine": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "text of the invoice line. Used in electronic-invoice-line requests."
        },
        "itemId": {
          "type": "string",
          "description": "id of the product (item). Used in electronic-invoice-line requests."
        }
      }
    },
    "typeModel": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "format": "int64",
          "description": "Version number of the model."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the model was created."
        },
        "datasetSize": {
          "type": "integer",
          "format": "int32",
          "description": "Size of the dataset the model was trained on, in examples."
        },
        "trainingSize": {
          "type": "integer",
          "format": "int32",
          "description": "Number of examples used for training."
        },
        "confidenceScores": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/typeTargetMetrics"
          },
          "description": "Evaluation metrics for each target, at precisions of 0.8, 0.9 and 0.95 where available."
        },
        "inputType": {
          "$ref": "#/definitions/ModelInputType"
        },
        "datasetType": {
          "type": "string",
          "description": "Type of the dataset the model was trained on: bank, scanned-invoice or\nelectronic-invoice-line."
        },
        "modelFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/typeModelFile"
          },
          "description": "Files of the trained model."
        },
        "targetToConfidenceThresholds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/typeConfidenceThresholds"
          },
          "description": "For each target, the confidence value at which each confidence level starts."
        },
        "targetToClassCount": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int32"
          },
          "description": "For each target, the number of classes, that is distinct values, it has."
        }
      },
      "description": "A trained model."
    },
    "typeModelFile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the file."
        },
        "data": {
          "type": "string",
          "format": "byte",
          "description": "Contents of the file."
        }
      },
      "description": "A file of a trained model."
    },
    "typeModelType": {
      "type": "string",
      "enum": [
        "DEFAULT",
        "TENSORFLOW",
        "ONNX"
      ],
      "default": "DEFAULT",
      "description": "Format of a trained model."
    },
    "typePrediction": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/PredictionTarget"
          },
          "description": "One entry per target of the model."
        },
        "unknownTokenPercentage": {
          "type": "number",
          "format": "float",
          "description": "Share of the input's tokens the model doesn't know, from 0 to 1. The suggest endpoints don't\nfill it in."
        }
      },
      "description": "Suggestions for one input, with one entry per target."
    },
    "typeRetentionPolicy": {
      "type": "object",
      "properties": {
        "maxDays": {
          "type": "string",
          "format": "int64",
          "description": "Number of days examples count for training. Older examples are left out of training. The\ndefault is 180, which also applies when you send 0."
        }
      },
      "description": "How long examples are used for training."
    },
    "typeSample": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/definitions/typeData"
        },
        "targetValues": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/typeTargetValue"
          }
        }
      }
    },
    "typeSupplier": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "id of the supplier; not nullable"
        },
        "name": {
          "type": "string",
          "title": "name of the supplier"
        },
        "globalId": {
          "type": "string",
          "title": "global id of the supplier"
        }
      }
    },
    "typeTargetMetrics": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "Name of the target."
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/TargetMetricsMetric"
          },
          "description": "Results at different confidence thresholds."
        },
        "entropy": {
          "type": "number",
          "format": "float",
          "description": "Entropy of the dataset."
        },
        "numberOfClasses": {
          "type": "integer",
          "format": "int32",
          "description": "Number of classes in the dataset."
        },
        "avgSamplePerClass": {
          "type": "number",
          "format": "float",
          "description": "Average number of examples per class."
        },
        "inconsistentLabelRatio": {
          "type": "number",
          "format": "float",
          "description": "Ratio of inconsistent labels."
        },
        "avgLabelsPerInconsistentSample": {
          "type": "number",
          "format": "float",
          "description": "Average number of labels per inconsistent example."
        },
        "percentSamplesNotInTargetVocab": {
          "type": "number",
          "format": "float",
          "description": "Percentage of examples whose value isn't in the target's vocabulary."
        },
        "jsDivergenceClasses": {
          "type": "number",
          "format": "float",
          "description": "Jensen-Shannon divergence of the classes."
        },
        "targetTrainSize": {
          "type": "integer",
          "format": "int32",
          "description": "Number of training examples with a value for this target."
        },
        "targetTestSize": {
          "type": "integer",
          "format": "int32",
          "description": "Number of test or validation examples with a value for this target."
        }
      },
      "description": "Evaluation metrics of a model for one target."
    },
    "typeTargetValue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "title": "Record mapping a target name to a value"
    },
    "typeTransaction": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "text of the bank transaction. Used in bank requests."
        },
        "amount": {
          "type": "number",
          "format": "float",
          "description": "amount of the transaction. Used in bank requests."
        }
      }
    },
    "v1CalculateMetricsResponse": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/CalculateMetricsResponseMetricRow"
          }
        }
      }
    },
    "v1CallsPerMonth": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "string",
          "format": "int64"
        },
        "monthName": {
          "type": "string"
        },
