{
  "swagger": "2.0",
  "info": {
    "title": "Product Types",
    "description": "Product Types classifies free-text descriptions, such as invoice lines or bank transactions, into 74 standardized product types, and returns ranked candidates with confidence scores.\n\n**Hosts:** `api.prod.asgt.visma.ai` for production and `api.stag.asgt.visma.ai` for staging.\n\n**Authentication:** send your project token as `Authorization: Bearer \u003ctoken\u003e`. See [Authentication](https://docs.vml.visma.ai/authentication/).\n\n**Errors:** a failed call returns an HTTP error status with a JSON body that holds `code`, `message` and `details`.\n\n**Guides:** [Product Types](https://docs.vml.visma.ai/producttypes/getting-started/) and [limits and rate limits](https://docs.vml.visma.ai/rate-limit/).",
    "version": "v2"
  },
  "tags": [
    {
      "name": "ProductTypeService",
      "description": "Suggest product types from text descriptions."
    }
  ],
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v2/models/product-types:batchSuggest": {
      "post": {
        "summary": "Suggest product types for a batch of texts.",
        "description": "Returns one suggestion per text, in the same order, each with ranked product type\ncandidates. Send 1 to 512 texts, none of them empty.",
        "operationId": "ProductTypeService_BatchSuggest",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v2ProductTypeBatchSuggestResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Request body for POST /v2/models/product-types:batchSuggest.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v2ProductTypeBatchSuggestRequest"
            }
          }
        ],
        "tags": [
          "ProductTypeService"
        ]
      }
    },
    "/v2/models/product-types:feedback": {
      "post": {
        "summary": "Send the correct product types for texts.",
        "description": "Stores each text with its correct product type and the model's current candidates for it,\nto evaluate the model. Returns 400 if texts is empty, if texts and trueCategories differ in\nlength, or if a category isn't a ProductType name.",
        "operationId": "ProductTypeService_Feedback",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {}
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Request body for POST /v2/models/product-types:feedback.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v2ProductTypeFeedbackRequest"
            }
          }
        ],
        "tags": [
          "ProductTypeService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v2ConfidenceLevel": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "VERY_LOW",
        "LOW",
        "MID",
        "HIGH",
        "VERY_HIGH"
      ],
      "default": "UNKNOWN",
      "description": "Confidence level of a product type candidate, from VERY_LOW to VERY_HIGH. UNKNOWN means the\nmodel gave no level."
    },
    "v2InternalProductTypeBatchSuggestResponse": {
      "type": "object",
      "properties": {
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v2ProductTypeSuggestion"
          },
          "description": "One suggestion per text, in the same order as the request."
        },
        "logits": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v2ProductTypeLogits"
          },
          "description": "The model's raw scores for each text, in the same order."
        }
      },
      "description": "Response of an internal method that isn't available over HTTP."
    },
    "v2ProductType": {
      "type": "string",
      "enum": [
        "UNDEFINED",
        "ACCOUNTING_AUDIT",
        "ACCOUNTING_SOFTWARE",
        "ADVERTISING",
        "ALCOHOL_TOBACCO",
        "MEDICAL_LAB_EQUIPMENT",
        "BANKING_INVESTMENT",
        "BOOKS",
        "BUSINESS_CONSULTING",
        "CHEMICALS",
        "CLEANING_SERVICES",
        "CLEANING_SUPPLIES",
        "CLOTHING",
        "ELECTRONICS",
        "CONSTRUCTION_MATERIALS",
        "DECORATIONS_ART",
        "DEFENSE_SECURITY",
        "DEPOSITS",
        "DOMESTIC_APPLIANCES",
        "EDUCATION_TRAINING",
        "ENERGY",
        "FACILITY_MAINTENANCE",
        "AGRICULTURE",
        "FEES",
        "FINES",
        "FOOD_BEVERAGES",
        "FUEL_LUBRICANTS",
        "FURNITURE",
        "GIFTS",
        "GLASS_CERAMICS",
        "GOVERNMENT_SERVICES",
        "GRAPHIC_DESIGN",
        "FITNESS_CLUBS",
        "HEALTHCARE",
        "HOTELS",
        "INDUSTRIAL_MACHINERY",
        "MANUFACTURING",
        "INSURANCE",
        "INTERNET_MEDIA",
        "PROPERTY_RENTAL",
        "LEGAL",
        "PLANTS_ANIMALS",
        "MACHINERY_LEASING",
        "MARKETING",
        "MEETINGS",
        "MUSIC",
        "OFFICE_SUPPLIES",
        "PACKAGING",
        "PARKING",
        "PASSENGER_TRANSPORT",
        "PAYMENTS",
        "PAYROLL",
        "PERSONAL_SERVICES",
        "PERSONAL_CARE",
        "PHARMACEUTICALS",
        "MEDIA_SERVICES",
        "RECREATIONAL_SERVICES",
        "RESEARCH_TECH_CONSULTING",
        "RESTAURANTS",
        "RETIREMENT",
        "LOGISTICS",
        "SOFTWARE",
        "SPORTS_EQUIPMENT",
        "STORAGE",
        "TAXATION",
        "TELEPHONY",
        "TEXTILES",
        "JEWELRY",
        "TOLLS",
        "TOYS",
        "TRADE_REPAIR",
        "VEHICLE_RENTALS",
        "VEHICLES",
        "WATER_WASTE",
        "WEBSITE"
      ],
      "default": "UNDEFINED",
      "description": "The product types a text can be classified into. UNDEFINED isn't a product type: it's the\nempty value."
    },
    "v2ProductTypeBatchSuggestRequest": {
      "type": "object",
      "properties": {
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Texts to classify, such as invoice lines or bank transaction descriptions. Send 1 to 512\ntexts, none of them empty."
        }
      },
      "description": "Request body for POST /v2/models/product-types:batchSuggest."
    },
    "v2ProductTypeBatchSuggestResponse": {
      "type": "object",
      "properties": {
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v2ProductTypeSuggestion"
          },
          "description": "One suggestion per text, in the same order as the request."
        }
      },
      "description": "Product type suggestions for a batch of texts."
    },
    "v2ProductTypeCandidate": {
      "type": "object",
      "properties": {
        "type": {
          "description": "The product type, such as ACCOUNTING_SOFTWARE. It's left out when the model returns a\nlabel that has no product type.",
          "allOf": [
            {
              "$ref": "#/definitions/v2ProductType"
            }
          ]
        },
        "label": {
          "type": "string",
          "description": "The product type's name in words, such as \"Accounting software\"."
        },
        "confidence": {
          "type": "number",
          "format": "float",
          "description": "The model's confidence score for this candidate. Use confidenceLevel to decide whether to\ntrust it."
        },
        "confidenceLevel": {
          "$ref": "#/definitions/v2ConfidenceLevel"
        }
      },
      "description": "A product type candidate for a text."
    },
    "v2ProductTypeFeedbackRequest": {
      "type": "object",
      "properties": {
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The texts, such as invoice lines or bank transaction descriptions. At least one is\nrequired."
        },
        "trueCategories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The correct product type for each text, in the same order as texts, as a ProductType name\nsuch as ACCOUNTING_SOFTWARE."
        }
      },
      "description": "Request body for POST /v2/models/product-types:feedback."
    },
    "v2ProductTypeLogits": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "description": "The scores."
        }
      },
      "description": "The model's raw scores for one text, one per class. Only returned by an internal method."
    },
    "v2ProductTypeSuggestion": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v2ProductTypeCandidate"
          },
          "description": "The candidates, ranked by the model."
        }
      },
      "description": "Product type candidates for one text."
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "description": "Your project token, sent as `Bearer \u003ctoken\u003e`.",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
