          }
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "description": "Your project token, sent as `Bearer \u003ctoken\u003e`.",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
