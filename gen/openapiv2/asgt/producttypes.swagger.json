    "v2ProductTypeBatchSuggestRequest": {
      "type": "object",
      "properties": {
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Text descriptions to classify into product types."
        }
      }
    },
    "v2ProductTypeBatchSuggestResponse": {
